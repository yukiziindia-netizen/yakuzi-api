# ─────────────────────────────────────────────────────────────────────────────
# Integrations (Shopify / WooCommerce / Amazon SP-API)
#
# PLACEHOLDERS ONLY — never commit real values. Copy the keys you need into the
# API's .env (and into the hosting provider's environment for deployments).
#
# Every variable here is optional at boot: a provider whose credentials are
# missing is shown as unavailable in the seller UI instead of breaking startup.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required before ANY channel can be connected ─────────────────────────────
# Encrypts channel credentials at rest (AES-256-GCM). 32 bytes, hex or base64.
# Generate with:  openssl rand -hex 32
# Without this, authorization flows refuse to start rather than storing a token
# in plaintext. Rotating it invalidates existing connections (sellers reconnect).
INTEGRATIONS_ENCRYPTION_KEY=

# Public origin of the seller dashboard — where sellers are returned after an
# authorization completes.
SELLER_APP_URL=https://seller.yukizi.com

# Public origin of THIS API, including the /api prefix. Used to build the
# callback URLs handed to each platform. Must be HTTPS in production —
# WooCommerce silently refuses a non-HTTPS callback_url.
API_PUBLIC_URL=https://yukizi.com/api

# ── Shopify ──────────────────────────────────────────────────────────────────
# From the Shopify Partner Dashboard > Apps > (your app) > Client credentials.
# The redirect URI must be listed EXACTLY in the app's "Allowed redirection
# URL(s)", or Shopify rejects the authorization request.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=https://yukizi.com/api/integrations/shopify/callback

# ── WooCommerce ──────────────────────────────────────────────────────────────
# Intentionally none. WooCommerce credentials are generated per store by the
# seller's own site and delivered to our callback — there is no global app key.

# ── Amazon SP-API ────────────────────────────────────────────────────────────
# LWA credentials from Seller Central > Develop Apps > (your app) > LWA
# credentials. The App ID is the "amzn1.sp.solution.*" application id.
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_SP_API_APP_ID=
AMAZON_REDIRECT_URI=https://yukizi.com/api/integrations/amazon/callback

# While the SP-API app is still in draft, Amazon requires `version=beta` on the
# consent URL. Set to "false" ONLY after the app is published/authorized, or
# published-app authorizations will fail.
AMAZON_SP_API_APP_DRAFT=true
